map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

limit_req_zone $binary_remote_addr zone=onsite_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=onsite_auth:10m rate=5r/m;

upstream onsite_app {
    include /etc/nginx/upstreams/active.conf;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;
    error_page 421 /421.html;
    location = /421.html {
        internal;
        alias /etc/nginx/errors/421.html;
    }
    return 421;
}

server {
    listen 80;
    server_name ${APP_HOST};
    return 308 https://${APP_HOST}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/${APP_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_HOST}/privkey.pem;
    error_page 421 /421.html;
    location = /421.html {
        internal;
        alias /etc/nginx/errors/421.html;
    }
    return 421;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_HOST};

    ssl_certificate /etc/letsencrypt/live/${APP_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=(self)" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; upgrade-insecure-requests" always;

    client_max_body_size 20m;
    proxy_intercept_errors on;
    error_page 429 /429.html;
    error_page 500 502 503 504 /503.html;

    location = /429.html {
        internal;
        alias /etc/nginx/errors/429.html;
    }

    location = /503.html {
        internal;
        alias /etc/nginx/errors/503.html;
    }

    location ^~ /api/auth/ {
        limit_req zone=onsite_auth burst=5 nodelay;
        limit_req_status 429;
        error_page 429 = @auth_rate_limited;
        error_page 500 502 503 504 = @api_unavailable;
        proxy_pass http://onsite_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
    }

    location ^~ /api/ {
        limit_req zone=onsite_api burst=30 nodelay;
        limit_req_status 429;
        error_page 429 = @api_rate_limited;
        error_page 500 502 503 504 = @api_unavailable;
        proxy_pass http://onsite_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
    }

    location / {
        proxy_pass http://onsite_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }

    location @api_rate_limited {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "1" always;
        return 429 '{"error":{"code":"RATE_LIMITED","message":"Too many requests. Please wait and try again."}}';
    }

    location @auth_rate_limited {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "60" always;
        return 429 '{"error":{"code":"RATE_LIMITED","message":"Too many requests. Please wait and try again."}}';
    }

    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"OnSite is temporarily unavailable. Please try again shortly."}}';
    }
}
