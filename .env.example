# Copy to .env on the VPS and replace every placeholder. Never commit .env.
APP_ORIGIN=https://onsite.example.com
APP_HOST=onsite.example.com
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://onsite:change-me@postgres:5432/onsite?schema=public
POSTGRES_USER=onsite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onsite

# Leave SMTP_HOST blank locally to print email links in the dev terminal.
# Production requires a real SMTP provider for verification and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OnSite <no-reply@example.com>

# Used only for local development. Production requests must use APP_ORIGIN.
NODE_ENV=development
